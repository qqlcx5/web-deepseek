{
  /* --------------------------------- editor --------------------------------- */
  "editor.fontSize": 18, // 控制编辑器的字体大小。
  "editor.tabSize": 2, // 控制编辑器中制表符的宽度。整数值。
  "editor.tabCompletion": "on", // 在按下 Tab 键时进行 Tab 补全，将插入最佳匹配建议。
  "editor.suggest.showSnippets": true, // 启用后，IntelliSense 将显示"片段"建议。
  "editor.insertSpaces": true,
  "editor.suggestSelection": "first", // antfu: 优先选择第一个建议
  "editor.suggest.snippetsPreventQuickSuggestions": false, // 控制活动代码段是否阻止快速建议。
  "editor.inlineSuggest.showToolbar": "always", // 每当显示内联建议时，显示内联建议工具栏。
  "editor.inlineSuggest.enabled": true, // antfu: 启用内联建议
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true, // 控制每个方括号类型是否具有自己的独立颜色池。
  "editor.linkedEditing": true, // 启用或禁用链接编辑。
  "editor.stickyScroll.enabled": true,
  "editor.accessibilitySupport": "off", // 控制编辑器是否应运行在无障碍模式下。
  "editor.cursorSmoothCaretAnimation": "on", // 启用或禁用光标平滑过渡动画。
  "editor.detectIndentation": false, // 控制在基于文件内容打开文件时是否自动检测
  // "editor.fontLigatures": "'calt', 'ss04', 'ss01', 'ss02'",
  "editor.fontLigatures": "'calt', 'liga', 'cv01', 'ss01', 'zero'",
  "editor.renderControlCharacters": true, // 控制编辑器是否应呈现控制字符。
  "editor.renderWhitespace": "boundary", // antfu: 显示空白字符边界
  "editor.wordWrap": "off", // 默认不自动换行，避免代码结构被打散。
  "editor.wrappingIndent": "same", // 换行后保持同级缩进。
  "editor.smoothScrolling": true, // 控制编辑器是否使用动画滚动。
  "editor.mouseWheelZoom": true, // 使用 Ctrl/Cmd + 滚轮缩放编辑器。
  "editor.cursorBlinking": "smooth", // 控制编辑器小地图是否应呈现字符。
  "editor.scrollBeyondLastLine": false, // antfu: 文件末尾不保留多余空白区域
  "editor.cursorSurroundingLines": 6, // 保留上下文行，减少跳转时视线抖动。
  "editor.cursorSurroundingLinesStyle": "default",
  "editor.minimap.autohide": true, // 控制编辑器小地图是否应自动隐藏。
  "editor.minimap.enabled": true, // 控制编辑器小地图是否应呈现字符。
  "editor.guides.indentation": true, // 显示缩进参考线。
  "editor.guides.bracketPairs": "active", // antfu: 激活的括号对指南
  "editor.guides.highlightActiveIndentation": true, // 高亮当前缩进层级。
  // "editor.lineNumbers": "interval", // antfu: 间隔显示行号
  "editor.hover.sticky": true, // antfu: 粘性悬停
  "editor.occurrencesHighlight": "singleFile", // 仅高亮当前文件中的相同符号。
  "editor.selectionHighlight": true, // 高亮选中内容的其他匹配项。
  "editor.matchBrackets": "always", // 始终高亮匹配括号。
  "editor.lightbulb.enabled": "onCode", // 仅在代码区域显示灯泡提示。
  "editor.parameterHints.enabled": true, // 显示函数参数提示。
  // "editor.rename.enablePreview": true, // 重命名时预览受影响位置。
  "editor.snippetSuggestions": "inline", // 将代码片段以内联方式展示。
  "editor.formatOnSave": false, // 保持手动触发格式化。
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?", // antfu: 单词分隔符
  "editor.multiCursorModifier": "ctrlCmd", // antfu: 多游标修饰符
  "editor.unicodeHighlight.invisibleCharacters": false, // antfu: 不高亮不可见字符
  "editor.find.addExtraSpaceOnTop": false, // antfu: 查找不在顶部添加额外空间
  // 控制键入时是否应自动显示建议。这可以用于在注释、字符串和其他代码中键入时进行控制。
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": "on"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never" // ⚠️警告会添加分号
  },
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "material-icon-theme",
  "breadcrumbs.enabled": true, // 显示当前文件的路径与符号导航。
  "workbench.commandPalette.preserveInput": true, // 保留命令面板中的输入内容。
  "workbench.editor.scrollToSwitchTabs": true, // 控制在切换选项卡时是否滚动到顶部。
  "workbench.startupEditor": "welcomePage", // antfu: 启动时新建无标题文件
  // "workbench.startupEditor": "newUntitledFile", // antfu: 启动时新建无标题文件
  // "workbench.editor.tabActionLocation": "left", // antfu: 标签操作位置在左侧
  "workbench.fontAliasing": "antialiased", // antfu: 字体抗锯齿
  "workbench.list.smoothScrolling": true, // antfu: 列表平滑滚动
  // "workbench.preferredDarkColorTheme": "One Dark Pro Darker", // antfu: 首选深色主题
  // "workbench.preferredLightColorTheme": "Vitesse Light", // antfu: 首选浅色主题
  // "workbench.productIconTheme": "icons-carbon", // antfu: 产品图标主题
  // "workbench.sideBar.location": "right", // antfu: 侧边栏在右侧
  "workbench.tree.expandMode": "singleClick", // antfu: 单击展开树
  "workbench.tree.indent": 10, // antfu: 树缩进
  "workbench.editor.closeOnFileDelete": true, // antfu: 删除文件时关闭编辑器
  "workbench.editor.highlightModifiedTabs": true, // antfu: 高亮修改的标签
  "workbench.editor.enablePreview": true, // 单击用预览标签复用，避免每个文件都新开标签
  "workbench.editor.revealIfOpen": true, // 文件已在某标签打开则聚焦该标签，不重复开
  // "workbench.editor.enablePreview": false, // 单击文件直接常驻打开。
  // "workbench.editor.enablePreviewFromQuickOpen": false, // 快速打开后保留标签页。
  "workbench.editor.tabSizing": "shrink", // 标签过多时自动收缩。
  "workbench.editor.wrapTabs": true, // 允许标签自动换行。
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 5,
  "workbench.layoutControl.enabled": true, // 显示布局控制入口。
  "workbench.statusBar.visible": true, // 保留状态栏信息。
  "workbench.tips.enabled": false, // 关闭低价值提示气泡。
  // "workbench.autoDetectColorScheme": true, // antfu: 自动检测颜色方案
  // "window.autoDetectColorScheme": true, // antfu: 自动检测颜色方案（重复项）
  "security.workspace.trust.untrustedFiles": "open",
  "explorer.compactFolders": false, // 目录结构保持展开可读性。
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
