  /* ------------------------------ search/files ------------------------------ */
  // 搜索时排除 .gitignore 文件。 search.useIgnoreFiles
  "search.useIgnoreFiles": true,
  // 搜索时排除文件。
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/yarn.lock": true,
    "**/package-lock.json": true
    // "**/theme-reference": true,
  },
  // 文件不会显示在工作空间
  "files.exclude": {
    "**/.git": true,
    "tmpclaude-*": true
